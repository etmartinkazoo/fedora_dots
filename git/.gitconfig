[user]
  name = Ted Martin
  email = etmartinkazoo@gmail.com

[core]
  editor = nvim

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[fetch]
  prune = true
  pruneTags = true

[rebase]
  autoStash = true

[merge]
  conflictstyle = zdiff3

[rerere]
  enabled = true

[commit]
  verbose = true

[diff]
  algorithm = histogram
  colorMoved = default

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[help]
  autocorrect = prompt

[color]
  ui = auto

[alias]
  l = log --oneline --graph
  lg = log --oneline --graph --all
  co = checkout
  br = branch
  ci = commit
  st = status -s
  unstage = restore --staged .
  amend = commit --amend --no-edit
  pr = pull --rebase

# Secret scan on every commit, in every repo. Config-based hooks (git >= 2.54)
# run alongside a repo's own .git/hooks / core.hooksPath hooks instead of
# replacing them. Skips quietly if gitleaks is absent; bypass a false positive
# with --no-verify or a .gitleaksignore entry.
[hook "gitleaks"]
  event = pre-commit
  command = command -v gitleaks >/dev/null 2>&1 || exit 0; gitleaks git --pre-commit --staged --redact --no-banner

# Machine-local SSH commit signing, generated by setup/security.sh once an
# ed25519 key exists (git skips a missing include).
[include]
  path = ~/.config/git/signing

[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
